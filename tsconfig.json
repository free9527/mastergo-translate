{
  "compilerOptions": {
    "sourceMap": false,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "removeComments": false,
    "jsx": "preserve",
    "importHelpers": true,
    "lib": ["esnext"],
    "types": [
      "@mastergo/plugin-typings"
    ],
    "paths": {
      "@lib/*": ["./lib/*"],
      "@ui/*": ["./ui/*"],
      "@messages/*": ["./messages/*"],
    },
  },
  "include": [
    "./lib/**/*.ts",
    "./messages/types.ts",
    "./messages/main-sender.ts",
    "./typings/plugin-runtime.d.ts"
  ]
}
