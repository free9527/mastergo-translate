{
  "name": "translate",
  "version": "0.2.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "yarn dev:ui & yarn dev:main",
    "dev:ui": "cross-env TARGET=ui NODE_ENV=development vite build --mode development -w",
    "dev:main": "cross-env TARGET=main NODE_ENV=development vite build --mode development -w",
    "build": "yarn build:ui && yarn build:main && rm -rf ./dist/assets",
    "typecheck:plugin": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
    "typecheck": "yarn typecheck:plugin && yarn typecheck:ui",
    "build:ui": "cross-env TARGET=ui vite build",
    "build:main": "cross-env TARGET=main vite build",
    "test": "npm run test:v105 && npm run test:v106 && npm run test:v107 && npm run test:v108",
    "test:v105": "cross-env TS_NODE_COMPILER_OPTIONS=\"{\\\"module\\\":\\\"commonjs\\\",\\\"esModuleInterop\\\":true,\\\"skipLibCheck\\\":true,\\\"types\\\":[\\\"node\\\"]}\" ts-node -r tsconfig-paths/register tests/test-v105-model-list-exemption.ts",
    "test:v106": "cross-env TS_NODE_COMPILER_OPTIONS=\"{\\\"module\\\":\\\"commonjs\\\",\\\"esModuleInterop\\\":true,\\\"skipLibCheck\\\":true,\\\"types\\\":[\\\"node\\\"]}\" ts-node -r tsconfig-paths/register tests/test-v106-misspelled-word.ts",
    "test:v107": "cross-env TS_NODE_COMPILER_OPTIONS=\"{\\\"module\\\":\\\"commonjs\\\",\\\"esModuleInterop\\\":true,\\\"skipLibCheck\\\":true,\\\"types\\\":[\\\"node\\\"]}\" ts-node -r tsconfig-paths/register tests/test-v107-cache-glossary-compliance.ts",
    "test:v108": "cross-env TS_NODE_COMPILER_OPTIONS=\"{\\\"module\\\":\\\"commonjs\\\",\\\"esModuleInterop\\\":true,\\\"skipLibCheck\\\":true,\\\"types\\\":[\\\"node\\\"]}\" ts-node -r tsconfig-paths/register tests/test-v108-expansion-to-proofread.ts"
  },
  "devDependencies": {
    "@types/node": "^17.0.21",
    "@vitejs/plugin-vue": "^2.2.4",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vite": "^2.8.6",
    "vite-plugin-singlefile": "^0.7.1",
    "xhr2": "^0.2.1"
  },
  "dependencies": {
    "@mastergo/plugin-typings": "^2.2.0",
    "csv-parse": "^7.0.1",
    "vue": "^3.2.31",
    "xlsx": "^0.18.5"
  }
}
